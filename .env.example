# LLM Provider (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=
# Optional: override default base URL
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional: override default model
# DEEPSEEK_MODEL=deepseek-chat

# Market data providers (optional backups; yfinance needs no key)
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=

# Backtest windows (comma-separated: 1w,1m,3m,to_date)
# X_TRACE_BACKTEST_WINDOWS=1m,3m

# Scoring weights (comma-separated key=float pairs; must sum to 1.0)
# X_TRACE_SCORE_WEIGHTS=hit_rate=0.30,avg_return=0.20,target_acc=0.15,sharpe=0.10,horizon=0.05,calibration=0.10,coverage=0.10

# Crawler settings
# X_TRACE_CRAWLER_REQUEST_INTERVAL_SEC=2.5
# X_TRACE_CRAWLER_MAX_RETRIES=3
